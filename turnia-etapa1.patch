+describe("checkSlot", () => {
+  const base = {
+    timeZone: BOGOTA,
+    startsAt: new Date("2026-10-26T15:00:00.000Z"), // lunes 10:00
+    durationMinutes: 30,
+    businessWindows: MON_TO_SAT,
+    staffWindows: MON_TO_SAT,
+    closures: [],
+    timeOffs: [],
