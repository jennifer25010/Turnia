+    ).toEqual({ ok: false, reason: "OUTSIDE_BUSINESS_HOURS" });
+  });
+
+  it("rechaza horarios en el pasado", () => {
+    expect(
+      checkSlot({ ...base, now: new Date("2026-10-27T00:00:00.000Z") }),
+    ).toEqual({ ok: false, reason: "PAST" });
