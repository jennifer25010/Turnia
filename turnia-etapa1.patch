+import type { Request, Response } from "express";
+import type { MembershipRole } from "@prisma/client";
+import { prisma } from "./lib/prisma.js";
+import { hashSessionToken } from "./auth.js";
+
+export const SESSION_COOKIE = "turnia_session";
+export const SESSION_DURATION_MS = 7 * 24 * 60 * 60 * 1000;
+
+export function readSessionCookie(
+  cookieHeader: string | undefined,
+): string | null {
+  if (!cookieHeader) return null;
+
+  for (const part of cookieHeader.split(";")) {
+    const separator = part.indexOf("=");
+    if (separator < 0) continue;
+
+    const name = part.slice(0, separator).trim();
+    const value = part.slice(separator + 1).trim();
+
+    if (name === SESSION_COOKIE && /^[A-Za-z0-9_-]{43}$/.test(value)) {
+      return value;
+    }
+  }
+
+  return null;
+}
+
+function cookieAttributes(maxAgeSeconds: number): string[] {
+  const attributes = [
+    "Path=/",
+    "HttpOnly",
+    "SameSite=Lax",
+    `Max-Age=${maxAgeSeconds}`,
+  ];
+
+  if (process.env.NODE_ENV === "production") {
+    attributes.push("Secure");
+  }
+
+  return attributes;
+}
+
+export function sessionCookie(token: string, maxAgeSeconds: number): string {
+  return [
+    `${SESSION_COOKIE}=${token}`,
+    ...cookieAttributes(maxAgeSeconds),
+  ].join("; ");
+}
+
+export function clearedSessionCookie(): string {
+  return [`${SESSION_COOKIE}=`, ...cookieAttributes(0)].join("; ");
+}
+
+export type BusinessAccess = {
+  userId: string;
+  membershipId: string;
+  /** Solo se informa cuando la autorización se pidió con `allowedRoles`. */
+  role?: MembershipRole;
+};
+
+function reject(
+  response: Response,
+  status: number,
+  code: string,
+  message: string,
+): null {
+  response.status(status).json({ error: { code, message } });
+  return null;
+}
+
+/**
+ * Autorización del lado del servidor para recursos de un negocio.
+ *
+ * Exige una sesión válida (cookie HttpOnly con hash en base de datos) y una
+ * membresía del usuario en `businessId`. Si `allowedRoles` se indica, además
+ * restringe por rol. Si la solicitud no está autorizada responde 401/403 y
+ * devuelve `null`; el llamador debe terminar sin hacer más trabajo.
+ */
+export async function authorizeBusinessAccess(
+  request: Request,
+  response: Response,
+  businessId: string,
+  allowedRoles?: readonly MembershipRole[],
+): Promise<BusinessAccess | null> {
+  const token = readSessionCookie(request.headers.cookie);
+
+  if (!token) {
+    return reject(response, 401, "UNAUTHENTICATED", "Debes iniciar sesión.");
+  }
+
+  const session = await prisma.session.findFirst({
+    where: {
+      tokenHash: hashSessionToken(token),
+      revokedAt: null,
+      expiresAt: { gt: new Date() },
+    },
+    select: {
+      user: {
+        select: {
+          id: true,
+          active: true,
+        },
+      },
+    },
+  });
+
+  if (!session || !session.user.active) {
+    return reject(
+      response,
+      401,
+      "UNAUTHENTICATED",
+      "La sesión no es válida o ha expirado.",
+    );
+  }
+
+  const forbidden = () =>
+    reject(
+      response,
+      403,
+      "FORBIDDEN",
+      "No tienes permiso para realizar esta acción en este negocio.",
+    );
+
+  // Sin restricción de rol solo se consulta la existencia de la membresía;
+  // con roles permitidos también se devuelve el rol para el llamador.
+  if (allowedRoles) {
+    const membership = await prisma.membership.findFirst({
+      where: {
+        businessId,
+        userId: session.user.id,
+        role: { in: [...allowedRoles] },
+      },
+      select: { id: true, role: true },
+    });
+    if (!membership) return forbidden();
+
+    return {
+      userId: session.user.id,
+      membershipId: membership.id,
+      role: membership.role,
+    };
+  }
+
+  const membership = await prisma.membership.findFirst({
+    where: { businessId, userId: session.user.id },
+    select: { id: true },
+  });
+  if (!membership) return forbidden();
+
+  return { userId: session.user.id, membershipId: membership.id };
+}
