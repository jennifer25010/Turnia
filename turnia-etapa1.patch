+const json = (body, status = 200) =>
+  new Response(JSON.stringify(body), {
+    status,
+    headers: { "Content-Type": "application/json" },
+  });
+
+const sessionBody = {
+  data: {
+    user: { id: "u1", email: "a@b.co", fullName: "Ana Pérez" },
+    memberships: [
+      {
+        businessId: "758ad131-14b1-42e4-8d74-d093bb62c41b",
