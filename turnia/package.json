{
  "name": "turnia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": "^22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,green \"pnpm --filter @turnia/web dev\" \"pnpm --filter @turnia/api dev\"",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @turnia/api test",
    "typecheck": "pnpm -r typecheck",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate"
  },
  "devDependencies": {
    "@prisma/client": "^6.19.0",
    "@eslint/js": "^9.29.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.29.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "prisma": "^6.19.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1"
  }
}
