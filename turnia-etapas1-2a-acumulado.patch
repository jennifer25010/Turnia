+    expect(checkSlot({ ...base, closures: [interval] })).toEqual({
+      ok: false,
+      reason: "BUSINESS_CLOSED",
+    });
+    expect(checkSlot({ ...base, timeOffs: [interval] })).toEqual({
+      ok: false,
+      reason: "STAFF_TIME_OFF",
+    });
